# =============================================================================
# Sensei OS Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit .env files with real credentials to version control
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Core Application Settings
# -----------------------------------------------------------------------------

# Application environment: development, staging, production
ENVIRONMENT=development

# Secret key for JWT signing - REQUIRED
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-in-production

# -----------------------------------------------------------------------------
# REQUIRED: Database Configuration
# -----------------------------------------------------------------------------

# PostgreSQL connection
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=sensei
POSTGRES_USER=sensei
POSTGRES_PASSWORD=change-this-password-in-production

# Full database URL (alternative to individual settings)
# DATABASE_URL=postgresql+asyncpg://sensei:password@postgres:5432/sensei

# -----------------------------------------------------------------------------
# REQUIRED: Redis Configuration
# -----------------------------------------------------------------------------

# Redis URL for caching and job queues
REDIS_URL=redis://redis:6379/0

# Redis password (REQUIRED)
REDIS_PASSWORD=change-this-redis-password

# -----------------------------------------------------------------------------
# OPTIONAL: Object Storage (MinIO/S3)
# -----------------------------------------------------------------------------

# MinIO/S3 configuration
MINIO_ROOT_USER=sensei
MINIO_ROOT_PASSWORD=change-this-password-in-production
S3_ENDPOINT=http://minio:9000
S3_BUCKET=sensei-files
S3_ACCESS_KEY=sensei
S3_SECRET_KEY=change-this-password-in-production

# -----------------------------------------------------------------------------
# OPTIONAL: Email/SMTP Configuration
# -----------------------------------------------------------------------------

# SMTP settings for sending emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Sensei OS

# -----------------------------------------------------------------------------
# OPTIONAL: Frontend Configuration
# -----------------------------------------------------------------------------

# Public API URL (accessible from browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Internal API URL (for server-side rendering)
API_INTERNAL_URL=http://api:8000

# -----------------------------------------------------------------------------
# OPTIONAL: Monitoring & Logging
# -----------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn

# -----------------------------------------------------------------------------
# OPTIONAL: Feature Flags
# -----------------------------------------------------------------------------

# Enable/disable features
ENABLE_ML_FEATURES=true
ENABLE_WEBSOCKETS=true
ENABLE_BACKGROUND_JOBS=true

# -----------------------------------------------------------------------------
# DEVELOPMENT ONLY: Debug Settings
# -----------------------------------------------------------------------------

# Enable debug mode (DO NOT enable in production)
DEBUG=false

# Enable API documentation (disable in production for security)
ENABLE_DOCS=true

# CORS origins (comma-separated, use * only in development)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# -----------------------------------------------------------------------------
# OPTIONAL: Port Configuration (for docker-compose)
# -----------------------------------------------------------------------------

# Service ports exposed to host
API_PORT=8000
WEB_PORT=3000
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Public app URL (for frontend links/redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
