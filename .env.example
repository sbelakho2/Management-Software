# =============================================================================
# Sensei OS Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit .env files with real credentials to version control
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Core Application Settings
# -----------------------------------------------------------------------------

# Application environment: development, staging, production
ENVIRONMENT=development

# JWT secret for token signing - REQUIRED
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-key-change-in-production

# Rust log level: trace, debug, info, warn, error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# REQUIRED: Database Configuration
# -----------------------------------------------------------------------------

# PostgreSQL connection
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=sensei
POSTGRES_USER=sensei
POSTGRES_PASSWORD=change-this-password-in-production

# Full database URL (used by Rust services)
DATABASE_URL=postgres://sensei:password@db:5432/sensei

# -----------------------------------------------------------------------------
# REQUIRED: NATS Configuration
# -----------------------------------------------------------------------------

# NATS JetStream URL (event bus for Rust workers)
NATS_URL=nats://nats:4222

# -----------------------------------------------------------------------------
# OPTIONAL: Object Storage (MinIO/S3)
# -----------------------------------------------------------------------------

# MinIO/S3 configuration
MINIO_ROOT_USER=sensei
MINIO_ROOT_PASSWORD=change-this-password-in-production
S3_ENDPOINT=http://minio:9000
S3_BUCKET=sensei-uploads
S3_ACCESS_KEY=sensei
S3_SECRET_KEY=change-this-password-in-production

# -----------------------------------------------------------------------------
# OPTIONAL: Email/SMTP Configuration
# -----------------------------------------------------------------------------

# SMTP settings for sending emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Sensei OS

# -----------------------------------------------------------------------------
# OPTIONAL: Monitoring & Logging
# -----------------------------------------------------------------------------

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn

# -----------------------------------------------------------------------------
# OPTIONAL: Rust API Configuration
# -----------------------------------------------------------------------------

# API server host and port
API_HOST=0.0.0.0
RUST_API_PORT=8080

# Rust environment flag
SENSEI_ENV=development

# -----------------------------------------------------------------------------
# OPTIONAL: Port Configuration (for docker-compose)
# -----------------------------------------------------------------------------

# Service ports exposed to host
POSTGRES_PORT=5432
NATS_PORT=4222
NATS_MONITOR_PORT=8222
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# DEVELOPMENT ONLY: Debug Settings
# -----------------------------------------------------------------------------

# Enable debug mode (DO NOT enable in production)
DEBUG=false

# CORS origins (comma-separated, use * only in development)
CORS_ORIGINS=http://localhost:8080

# -----------------------------------------------------------------------------
# OPTIONAL: Tri-System Integration (erpStarz + CRM-v2)
# -----------------------------------------------------------------------------

# StarzERP database for data sync
# STARZ_ERP_DATABASE_URL=postgresql://user:pass@erp-db:5432/erpstarz
# StarzERP REST API
# STARZ_ERP_API_URL=https://erp.starz.example.com/api

# CRM-v2 database for customer/lead data integration
# CRM_V2_DATABASE_URL=postgresql://user:pass@crm-db:5432/crmv2
# CRM-v2 REST API
# CRM_V2_API_URL=https://crm-v2.example.com/api
