# =============================================================================
# Sensei OS — Canonical Environment Variable Contract
# =============================================================================
# THIS FILE IS THE SINGLE SOURCE OF TRUTH for the Sensei OS environment
# contract. docker-compose.yml, the Helm chart (k8s/helm/sensei), and the
# Rust services (sensei-rs) all consume these exact variable names.
#
# Copy this file to .env and fill in real values.
# NEVER commit .env files with real credentials to version control.
#
# Valid environments (SENSEI_ENV is parsed STRICTLY — typos fail startup):
#   development | dev | staging | test | production | prod
# =============================================================================

# -----------------------------------------------------------------------------
# CORE APPLICATION
# -----------------------------------------------------------------------------

# Deployment environment. REQUIRED in production. Unknown values abort startup
# (e.g. SENSEI_ENV=prodution must NOT silently fall back to development).
SENSEI_ENV=development

# JWT signing secret — REQUIRED, at least 32 bytes.
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-key-change-in-production

# Optional: previous JWT signing key, accepted only for verification during a
# key rotation window (used when keys are rotated). Remove once rotation is
# complete.
# JWT_PREVIOUS_SIGNING_KEY=

# JWT access-token lifetime in minutes (default: 15)
JWT_ACCESS_TTL_MINUTES=15

# JWT refresh-token lifetime in days (default: 7)
JWT_REFRESH_EXPIRY_DAYS=7

# JWT issuer/audience claims (optional, defaults shown)
# JWT_ISSUER=sensei
# JWT_AUDIENCE=sensei-api

# Password for the CEO seed account created on first boot.
# NO DEFAULT: must be set explicitly. In production a placeholder or weak
# value (e.g. "1234") is rejected at startup.
# SENSEI_CEO_PASSWORD=

# Log level: trace, debug, info, warn, error (SENSEI_LOG is an alias)
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL 16 + pgvector)
# -----------------------------------------------------------------------------

# The POSTGRES_* variables are the single source for the database credentials.
# DATABASE_URL is DERIVED from them (docker-compose and Helm interpolate the
# full URL from these three values). When running outside Compose/Helm,
# substitute the values by hand.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=sensei
POSTGRES_USER=sensei
POSTGRES_PASSWORD=change-this-password-in-production

# Full database URL used by the Rust services (derived from the above).
# DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Optional tuning (defaults shown)
# DB_MAX_CONNECTIONS=20
# DB_CONNECTION_TIMEOUT=30
# DB_AUTO_MIGRATE=true

# -----------------------------------------------------------------------------
# EVENT BUS (NATS JetStream)
# -----------------------------------------------------------------------------

# NATS URL for the event bus (worker + API)
NATS_URL=nats://nats:4222
# NATS_CLUSTER=sensei
# NATS_MAX_RECONNECT=10

# -----------------------------------------------------------------------------
# API SERVER
# -----------------------------------------------------------------------------

API_HOST=0.0.0.0
API_PORT=8080

# CORS allowed origins, comma-separated. Use * only in development.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Optional tuning (defaults shown)
# API_BODY_LIMIT=10485760
# API_REQUEST_TIMEOUT=30

# -----------------------------------------------------------------------------
# OBJECT STORAGE (MinIO/S3)
# -----------------------------------------------------------------------------

# MinIO root credentials (used to derive S3 access keys in Compose)
MINIO_ROOT_USER=sensei
MINIO_ROOT_PASSWORD=change-this-password-in-production

# S3-compatible storage consumed by the Rust services
S3_ENDPOINT=http://minio:9000
S3_BUCKET=sensei-uploads
S3_ACCESS_KEY=sensei
S3_SECRET_KEY=change-this-password-in-production
# S3_REGION=us-east-1
# STORAGE_BACKEND=s3
# STORAGE_LOCAL_PATH=./data/uploads

# -----------------------------------------------------------------------------
# EMAIL / SMTP
# -----------------------------------------------------------------------------

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME=Sensei OS
# SMTP_USE_TLS=true

# -----------------------------------------------------------------------------
# REALTIME / IDEMPOTENCY (Rust workers & API)
# -----------------------------------------------------------------------------

# TTL (seconds) for realtime ticket deduplication/expiry
# REALTIME_TICKET_TTL_SECONDS=300

# TTL (seconds) for idempotent request deduplication
# IDEMPOTENCY_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# OBSERVABILITY
# -----------------------------------------------------------------------------

# Prometheus metrics port (separate from API port)
# METRICS_PORT=9090
# SENSEI_JSON_LOGS=false
# OTLP_ENDPOINT=
# SENSEI_SERVICE_NAME=sensei-api

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------

# Content-Security-Policy emitted by the backend (unset => built-in default)
# SECURITY_CSP=
# SECURITY_HSTS=true
# TRUSTED_PROXIES=

# -----------------------------------------------------------------------------
# DOCKER-COMPOSE HOST PORTS
# -----------------------------------------------------------------------------

POSTGRES_PORT=5432
NATS_PORT=4222
NATS_MONITOR_PORT=8222
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Uncomment to make plain `docker compose up -d` start the dev stack
# (sensei-api, sensei-workers, caddy) without passing --profile dev.
# COMPOSE_PROFILES=dev

# -----------------------------------------------------------------------------
# DEBUG (DEVELOPMENT ONLY — never in production)
# -----------------------------------------------------------------------------
DEBUG=false

# -----------------------------------------------------------------------------
# OPTIONAL: TRI-SYSTEM INTEGRATION (erpStarz + CRM-v2)
# -----------------------------------------------------------------------------

# StarzERP database for data sync
# STARZ_ERP_DATABASE_URL=postgresql://user:pass@erp-db:5432/erpstarz
# StarzERP REST API
# STARZ_ERP_API_URL=https://erp.starz.example.com/api

# CRM-v2 database for customer/lead data integration
# CRM_V2_DATABASE_URL=postgresql://user:pass@crm-db:5432/crmv2
# CRM-v2 REST API
# CRM_V2_API_URL=https://crm-v2.example.com/api
# -----------------------------------------------------------------------------
# AUTH / SESSIONS
# -----------------------------------------------------------------------------
# Previous signing key for JWT rotation (old tokens stay valid until expiry).
JWT_PREVIOUS_SIGNING_KEY=
# Access-token lifetime in minutes (default 15).
JWT_ACCESS_TTL_MINUTES=15
# Idempotency record lifetime in seconds (default 300).
IDEMPOTENCY_TTL_SECONDS=300
# One-time realtime ticket lifetime in seconds (default 30).
REALTIME_TICKET_TTL_SECONDS=30
# Internal monitoring token for /health/detailed and /metrics (empty = loopback only).
INTERNAL_HEALTH_TOKEN=
# Public self-registration (default: on in dev, off in production).
SELF_REGISTRATION_ENABLED=

# -----------------------------------------------------------------------------
# NATS
# -----------------------------------------------------------------------------
# Token for the NATS server (required when compose uses auth).
NATS_TOKEN=
# NATS URL (include the token when auth is enabled).
NATS_URL=nats://nats:4222

# -----------------------------------------------------------------------------
# PUBLIC URL / SENTRY
# -----------------------------------------------------------------------------
# Public base URL for email links (reset/verification).
PUBLIC_BASE_URL=http://localhost:3000
# Optional error reporting DSN.
SENTRY_DSN=

# -----------------------------------------------------------------------------
# ADMIN / CEO BOOTSTRAP (required in production)
# -----------------------------------------------------------------------------
SENSEI_ADMIN_EMAIL=admin@sensei.com
SENSEI_ADMIN_PASSWORD=
SENSEI_ADMIN_NAME=Admin User
SENSEI_CEO_EMAIL=ceo@starz.com
SENSEI_CEO_PASSWORD=

# -----------------------------------------------------------------------------
# TRI-SYSTEM INTEGRATION PROGRAM (reserved — not yet implemented)
# -----------------------------------------------------------------------------
# These services are gated behind the `integration` compose profile and are
# reserved for the erpStarz / CRM-v2 integration program (see Program.md).
INTEGRATION_DB_USER=integration
INTEGRATION_DB_PASSWORD=integration_dev_password
INTEGRATION_DB_NAME=integration
INTEGRATION_DB_PORT=5433
INTEGRATION_REDIS_PASSWORD=integration_dev_password
INTEGRATION_REDIS_PORT=6380
