# =============================================================================
# Caddyfile — Sensei OS Reverse Proxy Configuration
# =============================================================================
# This file configures Caddy as the reverse proxy for Sensei OS.
# For development: runs on :80 (HTTP) with WebSocket support at /ws.
# For production: uncomment the {$DOMAIN} block below or use Caddyfile.production.
#
# All API and WebSocket traffic routes to the Rust Axum API (sensei-api).
#
# SECURITY HEADER POLICY — see docs/guides/configuration-reference.md
# -----------------------------------------------------------------------------
# The security header policy is defined ONCE and emitted by the BACKEND
# (sensei-api/src/middleware/secure_headers.rs). Caddy must NOT duplicate or
# contradict those headers:
#   - X-XSS-Protection: "0" (the backend emits "0"; the legacy "1; mode=block"
#     was removed because it is ineffective and can create vulnerabilities).
#   - HSTS is emitted by the backend only (TLS-aware), never by Caddy.
#   - Content-Security-Policy is identical to the backend's built-in default.
#   - CORS is handled by the backend (CORS_ALLOWED_ORIGINS); Caddy adds no
#     Access-Control-* headers.
# If you must override any of these values, change the backend, not Caddy.
# =============================================================================

# Global options
{
    # Admin email for ACME (Let's Encrypt) certificates
    email admin@starzmorocco.com

    # Enable HTTP/2 and HTTP/3
    servers {
        protocols h1 h2 h2c h3
    }
}

# Production domain configuration - uncomment and set your domain for HTTPS
# {$DOMAIN:localhost} {
#     # Automatic HTTPS when domain is set (not localhost)
#     tls {$TLS_EMAIL:admin@starzmorocco.com}
# }

# =============================================================================
# Development configuration — HTTP for local development
# =============================================================================

# HTTP development server (no TLS — quick local access)
:80 {
    # =========================================================================
    # Global Middleware
    # =========================================================================

    # Response compression
    encode gzip

    # Security headers: the BACKEND (secure_headers.rs) is the single
    # owner of the browser-security policy (see
    # docs/guides/configuration-reference.md). Caddy emits NO security
    # headers of its own — one policy owner, no divergence.
    header {
        # Remove server header only
        -Server
    }

    # =========================================================================
    # Routes
    # =========================================================================

    # Realtime matcher — WebSocket + SSE must NOT inherit the general
    # API transport's short read/write timeouts (long-lived connections).
    @realtime path /api/v1/ws /api/v1/sse
    reverse_proxy @realtime sensei-api:8080 {
        transport http {
            dial_timeout 10s
        }
        health_uri /health/ready
        health_interval 30s
        health_timeout 5s
    }

    # API routes — proxies /api/* to Rust Axum API
    route /api/* {
        reverse_proxy sensei-api:8080 {
            transport http {
                read_timeout 60s
                write_timeout 60s
            }
            health_uri /health/ready
            health_interval 30s
            health_timeout 5s
        }
    }

    # Frontend routes — proxies all other requests to Rust API (serves Leptos WASM frontend)
    route /* {
        reverse_proxy sensei-api:8080 {
            health_uri /health/ready
            health_interval 30s
            health_timeout 5s
        }
    }
}

# =============================================================================
# HTTPS development server (TLS with self-signed certs)
# =============================================================================
# Enable this block for testing secure cookie functionality locally.
# Uncomment and generate certificates as described above.
#
# :443 {
#     # Self-signed TLS for development (use mkcert for proper certs, or
#     # uncomment 'tls internal' for Caddy-generated self-signed on the fly)
#     tls /etc/caddy/certs/localhost.pem /etc/caddy/certs/localhost-key.pem
#     # tls internal  # alternative: Caddy generates self-signed on the fly
#
#     encode gzip
#
#     # Security headers — policy owned by the backend (see top of file).
#     header {
#         X-Frame-Options "DENY"
#         X-Content-Type-Options "nosniff"
#         X-XSS-Protection "0"
#         Referrer-Policy "strict-origin-when-cross-origin"
#         Permissions-Policy "camera=(), microphone=(), geolocation=()"
#         
#         -Server
#     }
#
#     route /ws/* {
#         reverse_proxy sensei-api:8080 {
#             health_uri /health/ready
#             health_interval 30s
#             health_timeout 5s
#         }
#     }
#
#     route /api/* {
#         reverse_proxy sensei-api:8080 {
#             health_uri /health/ready
#             health_interval 30s
#             health_timeout 5s
#         }
#     }
#
#     route /* {
#         reverse_proxy sensei-api:8080 {
#             health_uri /health/ready
