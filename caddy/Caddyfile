# HTTPS development server (TLS with self-signed certs)
# =============================================================================
# Enable this block for testing secure cookie functionality locally.
# Uncomment and generate certificates as described above.
#
# :443 {
#     # Self-signed TLS for development (use mkcert for proper certs, or
#     # uncomment 'tls internal' for Caddy-generated self-signed on the fly)
#     tls /etc/caddy/certs/localhost.pem /etc/caddy/certs/localhost-key.pem
#     # tls internal  # alternative: Caddy generates self-signed on the fly
#
#     encode gzip
#
#     # Security headers — policy owned by the backend (see top of file).
#     header {
#         X-Frame-Options "DENY"
#         X-Content-Type-Options "nosniff"
#         X-XSS-Protection "0"
