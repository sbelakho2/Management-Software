# =============================================================================
# Caddyfile — Sensei OS Reverse Proxy Configuration
# =============================================================================
# This file configures Caddy as the reverse proxy for Sensei OS.
# For development: runs on :80 (HTTP) with WebSocket support at /ws.
# For production: uncomment the {$DOMAIN} block below or use Caddyfile.production.
#
# All API and WebSocket traffic routes to the Rust Axum API (sensei-api).
# =============================================================================

# Global options
{
    # Admin email for ACME (Let's Encrypt) certificates
    email admin@starzmorocco.com

    # Security headers
    servers {
        # Enable HTTP/2 and HTTP/3
        protocols h1 h2 h2c h3
    }
}

# Production domain configuration - uncomment and set your domain for HTTPS
# {$DOMAIN:localhost} {
#     # Automatic HTTPS when domain is set (not localhost)
#     tls {$TLS_EMAIL:admin@starzmorocco.com}
# }

# =============================================================================
# Development configuration — HTTP for local development
# =============================================================================

# HTTP development server (no TLS — quick local access)
:80 {
    # =========================================================================
    # Global Middleware
    # =========================================================================

    # Response compression
    encode gzip

    # Security headers
    header {
        # HSTS (only meaningful over HTTPS, but included for completeness)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Prevent clickjacking
        X-Frame-Options "DENY"
        # MIME-type sniffing protection
        X-Content-Type-Options "nosniff"
        # XSS protection
        X-XSS-Protection "1; mode=block"
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
        # Content Security Policy (adjust as needed)
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws: wss:;"
        # Remove server header
        -Server
        # CORS headers
        Access-Control-Allow-Origin *
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    }

    # =========================================================================
    # Routes
    # =========================================================================

    # WebSocket route — proxies /ws/* to Rust API for real-time features
    route /ws/* {
        reverse_proxy sensei-api:8080 {
            health_uri /api/v1/health
            health_interval 30s
            health_timeout 5s
        }
    }

    # API routes — proxies /api/* to Rust Axum API
    route /api/* {
        reverse_proxy sensei-api:8080 {
            health_uri /api/v1/health
            health_interval 30s
            health_timeout 5s
        }
    }

    # Frontend routes — proxies all other requests to Rust API (serves Leptos WASM frontend)
    route /* {
        reverse_proxy sensei-api:8080 {
            health_uri /api/v1/health
            health_interval 30s
            health_timeout 5s
        }
    }
}

# =============================================================================
# HTTPS development server (TLS with self-signed certs)
